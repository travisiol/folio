# ---------------------------------------------------------------------------
# FOLIO — configuration. Copy to .env.local (or set in Vercel). Everything
# NEXT_PUBLIC_* ships to the browser; keep keys out of it.
# ---------------------------------------------------------------------------

# The BasketFactory contract (no constructor arguments). Empty: the site shows
# its normal screens with no baskets, and Create answers that it is not open yet.
NEXT_PUBLIC_FACTORY_ADDRESS=

# Block the factory was deployed in. Mint/redeem history is read from here;
# 0 reads the last 400,000 blocks only.
NEXT_PUBLIC_FACTORY_START_BLOCK=0

# WalletConnect Cloud project id (mobile wallets). Browser wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

NEXT_PUBLIC_SITE_URL=

# Network — defaults are Robinhood Chain (4663). Override only for a local
# hardhat node (chain 31337, http://127.0.0.1:8897).
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
# Local node only: map verified symbols to local test tokens, e.g. NVDA=0x…,AAPL=0x…
# Ignored on Robinhood Chain.
NEXT_PUBLIC_LOCAL_TOKENS=
